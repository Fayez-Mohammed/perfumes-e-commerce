# Copy this file to .env and fill in the real values.
# .env is ignored by Git; .env.example is safe to commit.

ASPNETCORE_ENVIRONMENT=Production

# Paymob
Paymob__BaseUrl=https://accept.paymob.com
Paymob__Currency=EGP
Paymob__SecretKey=egy_sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
Paymob__PublicKey=egy_pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
Paymob__HmacSecret=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
Paymob__CardIntegrationId=000000
Paymob__WalletIntegrationId=000000
Paymob__PublicApiUrl=https://YOUR-API-DOMAIN
Paymob__RedirectionUrlTemplate=https://YOUR-FRONTEND-DOMAIN/payment-result/{orderId}
